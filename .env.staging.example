# Plantilla sin secretos reales; copiar y completar en un archivo ignorado por Git.
# Mantener los nombres de variables: los scripts dependen de ellos.
# Complementa .env para scripts/staging.ps1; no es el archivo Docker del servidor.

# -----------------------------------------------------------------------------
# Servicios opcionales y visibilidad
# false mantiene ocultos los servicios o la suscripcion. No modificar la aprobacion de produccion desde aqui.
KERMANENTZAT_SUBSCRIPTION_PUBLIC=true

# -----------------------------------------------------------------------------
# Staging: despliegue y comprobaciones
# Alias SSH, rutas remotas y URL interna sin autenticacion frontal.
STAGING_SSH_HOST=lxc-apps-staging
STAGING_REPOSITORY_PATH=/opt/staging/projects/web-egiakermanentzat/repository
STAGING_COMPOSE_FILE=/opt/staging/projects/web-egiakermanentzat/repository/compose.staging.yml
STAGING_COMPOSE_ENV_FILE=/opt/staging/projects/web-egiakermanentzat/.env.staging
STAGING_BRANCH=main
STAGING_HEALTH_URL=http://192.168.10.42:18081/
STAGING_HEALTH_HOST=web-egiakermanentzat-stag.urtzi.fun

# -----------------------------------------------------------------------------
# Staging: acceso al frontal
# La URL publica usa Basic Auth. El .env compartido puede aportar estas tres variables.
STAGING_URL=https://web-egiakermanentzat-stag.urtzi.fun/
STAGING_FRONT_USER=
STAGING_FRONT_PASSWORD=
