# Plantilla sin secretos reales; copiar y completar en un archivo ignorado por Git.
# Mantener los nombres de variables: los scripts dependen de ellos.

# -----------------------------------------------------------------------------
# WordPress local y acceso al prototipo
# Configuracion usada por Docker y la instalacion local.
WP_PORT=8082
WP_ADMIN_USER=prototype_admin
WP_ADMIN_PASSWORD=replace-with-a-local-admin-password
WP_ADMIN_EMAIL=prototype@example.invalid

# -----------------------------------------------------------------------------
# Base de datos local
# Estas credenciales pertenecen a Docker; no son las de produccion.
WP_DB_NAME=kermanentzat
WP_DB_USER=kermanentzat
WP_DB_PASSWORD=replace-with-a-local-password
WP_DB_ROOT_PASSWORD=replace-with-another-local-password

# -----------------------------------------------------------------------------
# Servicios opcionales y visibilidad
# false mantiene ocultos los servicios o la suscripcion. No modificar la aprobacion de produccion desde aqui.
KERMANENTZAT_GA_MEASUREMENT_ID=
KERMANENTZAT_GA_APPROVED=false
KERMANENTZAT_SUBSCRIPTION_PUBLIC=false
KERMANENTZAT_SENDER_APPROVED=false

# -----------------------------------------------------------------------------
# Sender y correo
# Secretos de servicios. No versionar valores reales ni subir este archivo al servidor.
KERMANENTZAT_SENDER_API_TOKEN=
EMAIL_SENDER=
EMAIL_SENDER_PASSWORD=

# -----------------------------------------------------------------------------
# Produccion: WordPress y SFTP
# Credenciales utilizadas por scripts/production-release.py. No se copian al wp-config.php remoto.
WP_PRO_ADMIN_USER=
WP_PRO_ADMIN_PASSWORD=
egiakez_cluster131_hosting_ovh_net_USER=
egiakez_cluster131_hosting_ovh_net_PASSWORD=
